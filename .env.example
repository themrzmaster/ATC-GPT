# Virtual ATC Configuration
# Copy this file to .env and fill in your API keys

# Required API Keys
OPENAI_API_KEY=sk-your-openai-api-key
# Optional - if missing or out of credits, OpenAI TTS/STT is used automatically
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Audio providers: auto | elevenlabs | openai
ATC_TTS_PROVIDER=auto
ATC_STT_PROVIDER=auto
OPENAI_TTS_VOICE=onyx
# Set false for text-only testing
ATC_TTS_ENABLED=true

# Server Configuration (optional)
ATC_SERVER_HOST=127.0.0.1
ATC_SERVER_PORT=5000
ATC_DEBUG=false

# ElevenLabs Voice (optional)
# Default: Rachel (21m00Tcm4TlvDq8ikWAM)
# Options: Antoni, Arnold, Adam
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI Model (optional)
OPENAI_MODEL=gpt-5.6-luna
# Reasoning effort: none|minimal|low|medium|high (lower = faster radio)
OPENAI_REASONING_EFFORT=low

# ATC Defaults (optional)
ATC_DEFAULT_AIRPORT=KJFK
ATC_DEFAULT_CALLSIGN=N12345

# ATC Language: "en" for English (ICAO), "pt-br" for Brazilian Portuguese (DECEA)
ATC_LANGUAGE=en
